NEXT_PUBLIC_API_BASE_URL=http://localhost:5000

# Server-only Backend-for-Frontend configuration
# Never expose MERCHANT_API_KEY to the browser or via NEXT_PUBLIC_*
GATEWAY_API_BASE_URL=http://localhost:5000
MERCHANT_API_KEY=pg_live_replace_with_your_demo_merchant_key
